# Copy to .env and fill in. NEVER commit .env or expose the secret to the browser.
# Razorpay Dashboard → Account & Settings → API Keys (use Test Mode keys first: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Webhooks → add https://YOUR-DOMAIN/api/v1/payments/webhook
# events: payment.captured, payment.failed, order.paid ; set this same secret there
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

PORT=3000
MIN_INR=50
MAX_INR=100000

# PolarAI (optional). Get a key at https://console.anthropic.com . Without it, PolarAI still answers from the built-in knowledge base.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
